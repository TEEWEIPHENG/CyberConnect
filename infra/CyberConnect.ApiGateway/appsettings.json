{
  "Keycloak": {
    "Authority": "https://auth.cyberconnect.local/realms/cyberconnect",
    "Audience": "cyberconnect-api",
    "RequireHttpsMetadata": true,
    "ValidateIssuer": true,
    "ValidateAudience": true
  },
  "ReverseProxy": {
    "Routes": {
      "tenant-route": {
        "ClusterId": "tenant-service",
        "Match": {
          "Path": "/api/v1/tenant/{**catch-all}"
        }
      },

      "user-route": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/v1/user/{**catch-all}"
        }
      },

      "audit-route": {
        "ClusterId": "audit-service",
        "Match": {
          "Path": "/api/v1/audit/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "tenant-service": {
        "Destinations": {
          "tenant-service-1": {
            "Address": "http://localhost:5001/"
          }
        }
      },

      "user-service": {
        "Destinations": {
          "user-service-1": {
            "Address": "http://localhost:5002/"
          }
        }
      },

      "audit-service": {
        "Destinations": {
          "audit-service-1": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}